{$APP_DOMAIN} {
	encode zstd gzip

	@backend path /api /api/* /static /static/* /health
	handle @backend {
		reverse_proxy backend-web:8089
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
