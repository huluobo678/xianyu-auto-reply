{$APP_DOMAIN} {
	encode zstd gzip

	@backend path /api /api/* /static /static/* /health
	handle @backend {
		reverse_proxy backend-web:8089
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# 兑换码商城 iframe 仅允许内嵌本站与链动小铺 pay.ldxp.cn；
		# 不放开 script-src / connect-src 等其它策略，也不引入支付宝域名。
		Content-Security-Policy "frame-src 'self' https://pay.ldxp.cn"
		-Server
	}

	log {
		output stdout
		format console
	}
}
